{
    "name": "sendkuy/laravel",
    "description": "SendKuy for Laravel: WhatsApp, SMS and email notifications, a facade, and signed webhooks.",
    "type": "library",
    "license": "MIT",
    "keywords": ["sendkuy", "laravel", "laravel-notification-channel", "whatsapp", "whatsapp-api", "sms", "email", "otp", "notifications", "messaging", "indonesia"],
    "homepage": "https://docs.sendkuy.com/laravel",
    "support": {
        "issues": "https://github.com/sendkuy/sendkuy-laravel/issues",
        "source": "https://github.com/sendkuy/sendkuy-laravel",
        "docs": "https://docs.sendkuy.com/laravel"
    },
    "require": {
        "php": "^8.2",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/notifications": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "sendkuy/sdk": "^1.0"
    },
    "require-dev": {
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^10.0|^11.0",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^11.5|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "SendKuy\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SendKuy\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SendKuy\\Laravel\\SendKuyServiceProvider"
            ],
            "aliases": {
                "SendKuy": "SendKuy\\Laravel\\Facades\\SendKuy"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "format": "pint"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
